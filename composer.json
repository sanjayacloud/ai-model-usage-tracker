{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sanjayacloud/ai-model-usage-tracker",
    "description": "Accurately track AI model usage, tokens, and cost in Laravel with automatic instrumentation, reporting, and a Blade dashboard.",
    "keywords": [
        "laravel",
        "sanjayacloud",
        "ai",
        "usage",
        "tokens",
        "cost",
        "openai",
        "anthropic",
        "ai-model-usage-tracker"
    ],
    "suggest": {
        "laravel/ai": "Automatic usage instrumentation for the first-party Laravel AI SDK.",
        "prism-php/prism": "Capture usage from Prism responses via capturePrism().",
        "inertiajs/inertia-laravel": "Required to render the bundled Inertia/Vue usage dashboard."
    },
    "homepage": "https://github.com/sanjayacloud/ai-model-usage-tracker",
    "license": "MIT",
    "authors": [
        {
            "name": "Sanjaya",
            "email": "sanjayaprasanna20@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "larastan/larastan": "^3.9",
        "laravel/ai": "^0.10",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "AiModelUsageTracker\\AiModelUsageTracker\\": "src/",
            "AiModelUsageTracker\\AiModelUsageTracker\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiModelUsageTracker\\AiModelUsageTracker\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "AiModelUsageTracker\\AiModelUsageTracker\\AiModelUsageTrackerServiceProvider"
            ],
            "aliases": {
                "AiModelUsageTracker": "AiModelUsageTracker\\AiModelUsageTracker\\Facades\\AiModelUsageTracker",
                "UsageTracker": "AiModelUsageTracker\\AiModelUsageTracker\\Facades\\UsageTracker"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
